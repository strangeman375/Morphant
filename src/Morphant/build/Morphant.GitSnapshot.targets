<Project>
  <!-- Retain global hooks and register after subsequent imports have evaluated. -->
  <Target Name="RegisterMorphantGitSnapshotPublication">
    <CreateProperty Value="$(TargetsTriggeredByCompilation);PublishMorphantGitSnapshot">
      <Output TaskParameter="ValueSetByTask" PropertyName="TargetsTriggeredByCompilation" />
    </CreateProperty>
  </Target>
</Project>
