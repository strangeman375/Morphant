<Project>
  <!--
    Register snapshot files before the SDK creates its default Compile items.
    Some IDE project models briefly treat a late Compile Remove as stale and
    feed the checked-in mapper back into the source generator.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/Morphant.Generated.*.g.cs</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="MorphantMappingMode" />
    <CompilerVisibleProperty Include="MorphantNullSourceHandling" />
    <CompilerVisibleProperty Include="MorphantNullDestinationHandling" />
    <CompilerVisibleProperty Include="MorphantUnknownDerivedTypeHandling" />
    <CompilerVisibleProperty Include="MorphantConstructorSelection" />
    <CompilerVisibleProperty Include="MorphantMemberSelection" />
    <CompilerVisibleProperty Include="MorphantFlattening" />
    <CompilerVisibleProperty Include="MorphantUnmappedMemberValidation" />
  </ItemGroup>
</Project>
