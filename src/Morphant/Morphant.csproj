<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Morphant.Product.props" />

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <IsPackable>true</IsPackable>
        <EnablePackageValidation>true</EnablePackageValidation>

        <PackageId>Morphant</PackageId>
        <Title>Morphant</Title>
        <Description>Compile-time object mapper for C# that generates strongly typed mapping code from explicit configuration, without runtime reflection.</Description>

        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>mapper;mapping;object-mapper;object-mapping;source-generator;code-generation;compile-time;roslyn;csharp</PackageTags>
        <PackageReleaseNotes>Adds first-class tuple mappings and self-typed mapper configuration, with improved generator stability and incremental updates. Includes breaking API changes; see the migration instructions. Release notes: https://github.com/strangeman375/Morphant/blob/v0.5.0/CHANGELOG.md#050. Current limitations: https://github.com/strangeman375/Morphant/blob/v0.5.0/docs/limitations.md</PackageReleaseNotes>

        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PackageOutputPath>..\..\artifacts\packages</PackageOutputPath>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectMorphantPackageTools</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Morphant.GeneratorContractVersion"
                          Value="2" />

        <ProjectReference Include="..\Morphant.Generator\Morphant.Generator.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="..\Morphant.Build.Tasks\Morphant.Build.Tasks.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\logo.png"
              Pack="true"
              PackagePath="\"
              Visible="false" />

        <None Include="..\..\README.md"
              Pack="true"
              PackagePath="\"
              Visible="false" />

        <None Include="..\..\LICENSE"
              Pack="true"
              PackagePath="\"
              Visible="false" />

        <None Include="build\Morphant.props"
              Pack="true"
              PackagePath="buildTransitive\Morphant.props"
              Visible="false" />

        <None Include="build\Morphant.targets"
              Pack="true"
              PackagePath="buildTransitive\Morphant.targets"
              Visible="false" />
    </ItemGroup>

    <Target Name="CollectMorphantPackageTools">
        <!-- Resolve the selected output paths without rebuilding during packaging-only steps. -->
        <MSBuild Projects="@(ProjectReference)"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_MorphantPackageTool" />
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_MorphantPackageTool)"
                                    Condition="'%(_MorphantPackageTool.Filename)' == 'Morphant.Generator'"
                                    PackagePath="analyzers/dotnet/cs/" />
            <TfmSpecificPackageFile Include="@(_MorphantPackageTool)"
                                    Condition="'%(_MorphantPackageTool.Filename)' == 'Morphant.Build.Tasks'"
                                    PackagePath="buildTransitive/" />
        </ItemGroup>
    </Target>

</Project>
