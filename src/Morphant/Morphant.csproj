<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Morphant.Product.props" />

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <IsPackable>true</IsPackable>
        <EnablePackageValidation>true</EnablePackageValidation>

        <PackageId>Morphant</PackageId>
        <Title>Morphant</Title>
        <Description>Compile-time object mapper for C# that generates strongly typed mapping code from explicit configuration, without runtime reflection.</Description>

        <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>mapper;mapping;object-mapper;object-mapping;source-generator;code-generation;compile-time;roslyn;csharp</PackageTags>
        <PackageReleaseNotes>Adds explicit pair-local runtime polymorphism with ForDerived, most-specific class/interface dispatch, strict Update destination checks, value-type support, configurable unknown-derived handling, and dedicated diagnostics and runtime exceptions. Release notes: https://github.com/strangeman375/Morphant/blob/v0.4.0/CHANGELOG.md#040. Current limitations: https://github.com/strangeman375/Morphant/blob/v0.4.0/docs/limitations.md</PackageReleaseNotes>

        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PackageOutputPath>..\..\artifacts\packages</PackageOutputPath>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="Morphant.GeneratorContractVersion"
                          Value="2" />

        <ProjectReference Include="..\Morphant.Generator\Morphant.Generator.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="..\Morphant.Build.Tasks\Morphant.Build.Tasks.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\logo.png"
              Pack="true"
              PackagePath="\"
              Visible="false" />

        <None Include="..\..\README.md"
              Pack="true"
              PackagePath="\"
              Visible="false" />

        <None Include="..\..\LICENSE"
              Pack="true"
              PackagePath="\"
              Visible="false" />

        <None Include="..\Morphant.Generator\bin\$(Configuration)\netstandard2.0\Morphant.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false" />

        <None Include="build\Morphant.props"
              Pack="true"
              PackagePath="buildTransitive\Morphant.props"
              Visible="false" />

        <None Include="build\Morphant.targets"
              Pack="true"
              PackagePath="buildTransitive\Morphant.targets"
              Visible="false" />

        <None Include="..\Morphant.Build.Tasks\bin\$(Configuration)\netstandard2.0\Morphant.Build.Tasks.dll"
              Pack="true"
              PackagePath="buildTransitive\Morphant.Build.Tasks.dll"
              Visible="false" />
    </ItemGroup>

</Project>
