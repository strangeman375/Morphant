<Project>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          Keep the shipped generator compiled against the minimum supported
          Roslyn host. Override this property when validating newer hosts.
        -->
        <MorphantRoslynVersion Condition="'$(MorphantRoslynVersion)' == ''">4.9.2</MorphantRoslynVersion>

        <!-- Stable assembly identity shared by the product and its friend test assemblies. -->
        <MorphantStrongNameKeyFile>$(MSBuildThisFileDirectory)Morphant.snk</MorphantStrongNameKeyFile>
        <MorphantStrongNamePublicKey></MorphantStrongNamePublicKey>

        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>
