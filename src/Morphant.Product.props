<Project>

    <PropertyGroup>
        <Version>0.5.0</Version>

        <!--
          The assembly version is the binary-compatibility line: patch releases
          keep it, and MORPH0063 compares the line that libraries reference.
        -->
        <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+').Value).0.0</AssemblyVersion>

        <Authors>strangeman375</Authors>
        <Company>strangeman375</Company>
        <Product>Morphant</Product>
        <MorphantCopyrightYear
                Condition="'$(MorphantCopyrightYear)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy'))</MorphantCopyrightYear>
        <Copyright>Copyright (c) strangeman375 $(MorphantCopyrightYear)</Copyright>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/strangeman375/Morphant</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MorphantStrongNameKeyFile)</AssemblyOriginatorKeyFile>
    </PropertyGroup>

</Project>
