<Project>

    <PropertyGroup>
        <Version>0.1.0</Version>

        <!-- Keep patch releases in the 0.1 line binary-compatible. -->
        <AssemblyVersion>0.1.0.0</AssemblyVersion>

        <Authors>strangeman375</Authors>
        <Company>strangeman375</Company>
        <Product>Morphant</Product>
        <MorphantCopyrightYear
                Condition="'$(MorphantCopyrightYear)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy'))</MorphantCopyrightYear>
        <Copyright>Copyright (c) strangeman375 $(MorphantCopyrightYear)</Copyright>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/strangeman375/Morphant</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MorphantStrongNameKeyFile)</AssemblyOriginatorKeyFile>
    </PropertyGroup>

</Project>
