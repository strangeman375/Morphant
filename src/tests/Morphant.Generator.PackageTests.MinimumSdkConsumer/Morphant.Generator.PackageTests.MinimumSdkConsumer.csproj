<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MorphantTestPackageVersion
        Condition="'$(MorphantTestPackageVersion)' == ''">0.0.0-minimum-sdk</MorphantTestPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Morphant"
                      Version="$(MorphantTestPackageVersion)" />
  </ItemGroup>

  <Target Name="MinimumSdkAfterCompile">
    <Error Condition="'$(TargetsTriggeredByCompilation)' != 'MinimumSdkAfterCompile;PublishMorphantGitSnapshot'"
           Text="The global compilation hook list was not preserved on the minimum SDK." />
    <WriteLinesToFile File="$(IntermediateOutputPath)minimum-sdk-hook.txt"
                      Lines="executed" Overwrite="true" />
  </Target>

</Project>
