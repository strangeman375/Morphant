<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MorphantStrongNameKeyFile)</AssemblyOriginatorKeyFile>
        <MorphantTestRoslynVersion Condition="'$(MorphantTestRoslynVersion)' == ''">$(MorphantRoslynVersion)</MorphantTestRoslynVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(MorphantTestRoslynVersion)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <!-- Keep the Roslyn test harness's transitive NuGet dependencies current. -->
        <PackageReference Include="NuGet.Resolver" Version="7.9.0" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.Build.Framework">
            <HintPath>$(MSBuildBinPath)/Microsoft.Build.Framework.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="CompatibilityDiagnosticsTests/Fixtures/*.txt">
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphant.Generator.UnitTests.TestAssets\Morphant.Generator.UnitTests.TestAssets.csproj" />
        <ProjectReference Include="..\..\Morphant.Build.Tasks\Morphant.Build.Tasks.csproj" />
        <ProjectReference Include="..\..\Morphant.Generator\Morphant.Generator.csproj" />
        <ProjectReference Include="..\..\Morphant\Morphant.csproj" />
    </ItemGroup>

</Project>
