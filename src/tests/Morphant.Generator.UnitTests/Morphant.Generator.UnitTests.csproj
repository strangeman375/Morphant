<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MorphantStrongNameKeyFile)</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="coverlet.collector" Version="10.0.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(MorphantRoslynVersion)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.Build.Framework">
            <HintPath>$(MSBuildBinPath)/Microsoft.Build.Framework.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="CompatibilityDiagnosticsTests/Fixtures/*.txt">
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphant.Generator.UnitTests.TestAssets\Morphant.Generator.UnitTests.TestAssets.csproj" />
        <ProjectReference Include="..\..\Morphant.Build.Tasks\Morphant.Build.Tasks.csproj" />
        <ProjectReference Include="..\..\Morphant.Generator\Morphant.Generator.csproj" />
        <ProjectReference Include="..\..\Morphant\Morphant.csproj" />
    </ItemGroup>

</Project>
