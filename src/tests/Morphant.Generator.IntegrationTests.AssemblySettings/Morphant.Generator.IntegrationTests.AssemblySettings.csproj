<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <MorphantMappingMode>Update</MorphantMappingMode>
        <MorphantNullSourceHandling>Throw</MorphantNullSourceHandling>
        <MorphantNullDestinationHandling>Throw</MorphantNullDestinationHandling>
        <MorphantConstructorSelection>Explicit</MorphantConstructorSelection>
        <MorphantMemberSelection>Explicit</MorphantMemberSelection>
        <MorphantFlattening>None</MorphantFlattening>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="MorphantMappingMode" />
        <CompilerVisibleProperty Include="MorphantNullSourceHandling" />
        <CompilerVisibleProperty Include="MorphantNullDestinationHandling" />
        <CompilerVisibleProperty Include="MorphantConstructorSelection" />
        <CompilerVisibleProperty Include="MorphantMemberSelection" />
        <CompilerVisibleProperty Include="MorphantFlattening" />

        <ProjectReference Include="..\..\Morphant\Morphant.csproj" />
        <ProjectReference Include="..\..\Morphant.Generator\Morphant.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
