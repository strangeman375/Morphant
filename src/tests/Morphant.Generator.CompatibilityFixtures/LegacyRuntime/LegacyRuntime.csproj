<Project Sdk="Microsoft.NET.Sdk">

    <!-- Stands in for the runtime package of an earlier Morphant release. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Morphant</AssemblyName>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MorphantStrongNameKeyFile)</AssemblyOriginatorKeyFile>
    </PropertyGroup>

</Project>
