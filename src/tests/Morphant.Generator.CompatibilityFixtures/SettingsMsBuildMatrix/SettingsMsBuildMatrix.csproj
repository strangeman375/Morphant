<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(MorphantGeneratedFilesPath)</CompilerGeneratedFilesOutputPath>

        <MorphantMappingMode>Unexpected</MorphantMappingMode>
        <MorphantNullSourceHandling>Unexpected</MorphantNullSourceHandling>
        <MorphantNullDestinationHandling>Unexpected</MorphantNullDestinationHandling>
        <MorphantConstructorSelection>Unexpected</MorphantConstructorSelection>
        <MorphantMemberSelection>Unexpected</MorphantMemberSelection>
        <MorphantFlattening>Unexpected</MorphantFlattening>
        <MorphantUnmappedMemberValidation>Unexpected</MorphantUnmappedMemberValidation>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="MorphantMappingMode" />
        <CompilerVisibleProperty Include="MorphantNullSourceHandling" />
        <CompilerVisibleProperty Include="MorphantNullDestinationHandling" />
        <CompilerVisibleProperty Include="MorphantConstructorSelection" />
        <CompilerVisibleProperty Include="MorphantMemberSelection" />
        <CompilerVisibleProperty Include="MorphantFlattening" />
        <CompilerVisibleProperty Include="MorphantUnmappedMemberValidation" />

        <Reference Include="Morphant">
            <HintPath>$(MorphantRuntimePath)</HintPath>
            <Private>false</Private>
        </Reference>
        <Analyzer Include="$(MorphantGeneratorPath)" />
    </ItemGroup>

</Project>
