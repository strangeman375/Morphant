<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <MorphantTestPackageVersion Condition="'$(MorphantTestPackageVersion)' == ''">0.0.0-package-consumption</MorphantTestPackageVersion>
        <MorphantMemberSelection>Explicit</MorphantMemberSelection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Morphant"
                          Version="$(MorphantTestPackageVersion)" />
    </ItemGroup>

    <Target Name="VerifyMorphantCompilerVisibleProperties"
            BeforeTargets="CoreCompile">
        <ItemGroup>
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantMappingMode" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantNullSourceHandling" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantNullDestinationHandling" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantUnknownDerivedTypeHandling" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantConstructorSelection" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantMemberSelection" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantFlattening" />
            <_MissingMorphantCompilerVisibleProperty
                    Include="MorphantUnmappedMemberValidation" />
            <_MissingMorphantCompilerVisibleProperty Remove="@(CompilerVisibleProperty)" />
        </ItemGroup>

        <Error Condition="'@(_MissingMorphantCompilerVisibleProperty)' != ''"
               Text="The Morphant package did not import CompilerVisibleProperty entries: @(_MissingMorphantCompilerVisibleProperty)." />
    </Target>

    <Target Name="VerifyMorphantDesignTimeGitSnapshotProperties"
            BeforeTargets="CoreCompile"
            Condition="'$(MorphantGitSnapshot)' == 'true' and
                       '$(DesignTimeBuild)' == 'true'">
        <Error Condition="'$(EmitCompilerGeneratedFiles)' != 'true'"
               Text="The Morphant package did not keep source emission enabled for the design-time compiler command line." />
        <Error Condition="'$(CompilerGeneratedFilesOutputPath)' != '$(_MorphantExpectedCompilerGeneratedFilesOutputPath)'"
               Text="The Morphant package did not keep its private generated-files path in the design-time compiler command line." />
    </Target>

</Project>
