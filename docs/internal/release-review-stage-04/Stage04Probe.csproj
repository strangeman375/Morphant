<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Audit.Stage04</AssemblyName>
    <RootNamespace>Stage04Audit</RootNamespace>
    <ReviewCase Condition="'$(ReviewCase)' == ''">Core</ReviewCase>
    <LangVersion Condition="'$(ReviewCase)' != 'Modern'">9.0</LangVersion>
    <LangVersion Condition="'$(ReviewCase)' == 'Modern'">11.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/generated/$(ReviewCase)</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Cases/$(ReviewCase).cs" />
    <ProjectReference Include="../../../src/Morphant/Morphant.csproj" />
    <ProjectReference Include="../../../src/Morphant.Generator/Morphant.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
